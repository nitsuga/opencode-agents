{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/muse-spark-1.3-contributor",
  "default_agent": "orchestrator",
  "experimental": {
    "subagent_depth": 1
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "task": "allow",
    "bash": {
      "*": "allow",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "dd if=* of=/dev/*": "deny",
      "mkfs*": "deny",
      "shutdown *": "ask",
      "reboot *": "ask",
      "poweroff *": "ask"
    },
    "external_directory": "allow"
  },
  "agents": {
    "orchestrator": {
      "model": "opencode-go/muse-spark-1.3-contributor#high"
    },
    "explore": {
      "model": "opencode-go/muse-spark-1.3-contributor#low"
    },
    "general": {
      "model": "opencode-go/muse-spark-1.3-contributor#high"
    },
    "oracle": {
      "model": "opencode-go/deepseek-v4.1-flash#high"
    },
    "designer": {
      "model": "opencode-go/gpt-5.6-luna#high"
    },
    "observer": {
      "model": "opencode-go/gpt-5.6-luna#high"
    }
  },
  "lsp": true,
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
      "ny-data-registry-mcp": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@betanyc/ny-data-registry-mcp"
        ]
      },
      "socrata": {
        "type": "local",
        "command": [
          "bash",
          "-c",
          "set -a; source /home/eric/.config/genealogy/socrata.env; exec npx -y socrata-mcp-server --stdio"
        ],
        "environment": {
          "DATA_PORTAL_URL": "https://data.cityofnewyork.us"
        }
      }
    }
  }
}
